<extensions xmlns="http://maven.apache.org/EXTENSIONS/1.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/EXTENSIONS/1.0.0 http://maven.apache.org/xsd/core-extensions-1.0.0.xsd">
  <!--
       Maven Incremental Module Builder https://github.com/khmarbaise/incremental-module-builder
       Usage: mvn -b incremental install
  -->
  <extension>
    <groupId>com.soebes.maven.extensions</groupId>
    <artifactId>incremental-module-builder</artifactId>
    <version>0.2.0</version>
  </extension>

  <extension>
    <groupId>fr.jcgay.maven</groupId>
    <artifactId>maven-profiler</artifactId>
    <version>3.3</version>
  </extension>

  <!--
       Maven Build Cache Extension https://maven.apache.org/extensions/maven-build-cache-extension/
       Caches build outputs to speed up builds. Supports local and remote caching.
       Configuration in maven-build-cache-config.xml
  -->
  <extension>
    <groupId>org.apache.maven.extensions</groupId>
    <artifactId>maven-build-cache-extension</artifactId>
    <version>1.2.0</version>
  </extension>
</extensions>
